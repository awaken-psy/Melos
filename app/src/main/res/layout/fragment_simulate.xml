<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Mode Toggle -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_trajectory"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="轨迹模拟"
                android:textSize="14sp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_fixed"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="定点打卡"
                android:textSize="14sp"
                app:cornerRadius="16dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Trajectory mode: Venue Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_venue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="场地"
                    android:textSize="12sp"
                    android:textColor="@color/md_on_surface_variant"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <AutoCompleteTextView
                        android:id="@+id/spinner_venue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:inputType="none"
                        android:textSize="15sp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="嘉定大操场" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fixed-point mode: Location Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_fixed_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打卡位置"
                    android:textSize="12sp"
                    android:textColor="@color/md_on_surface_variant"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:layout_marginBottom="8dp" />

                <!-- Saved locations dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_saved_locations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <AutoCompleteTextView
                        android:id="@+id/spinner_saved_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:inputType="none"
                        android:textSize="15sp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:hint="选择已保存的位置" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Add new location button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_location"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="选择新位置"
                    android:textSize="14sp"
                    app:cornerRadius="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:strokeColor="@color/md_primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pace Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_pace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_pace_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="配速  4分10秒/公里"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_on_surface" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_pace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:stepSize="10"
                    android:valueFrom="180"
                    android:valueTo="540"
                    android:value="250"
                    app:thumbColor="@color/md_primary"
                    app:trackColorActive="@color/md_primary"
                    app:trackColorInactive="@color/md_primary_container" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3:00/km"
                        android:textSize="11sp"
                        android:textColor="@color/text_hint" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:00/km"
                        android:textSize="11sp"
                        android:textColor="@color/text_hint" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Laps Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_laps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/md_surface_container_low"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/md_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_laps_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="圈数  5 圈"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_on_surface" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_laps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:stepSize="1"
                    android:valueFrom="1"
                    android:valueTo="10"
                    android:value="5"
                    app:thumbColor="@color/md_primary"
                    app:trackColorActive="@color/md_primary"
                    app:trackColorInactive="@color/md_primary_container" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未启动"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_stop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="开始模拟"
            android:textSize="16sp"
            app:backgroundTint="@color/success"
            app:cornerRadius="16dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preview_track"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="预览轨迹"
            android:textSize="14sp"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:strokeColor="@color/md_primary" />

    </LinearLayout>
</ScrollView>
